{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.ts"],
      "dependsOn": ["transit", "@ci/config-vitest#build"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "@ci/config-vitest#build"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "clean": {
      "cache": false
    }
  }
}
